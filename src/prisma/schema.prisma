generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())

  projects     Project[]
}

model Project {
  id        Int       @id @default(autoincrement())
  name      String
  ownerId   Int
  createdAt DateTime  @default(now())

  owner     User      @relation(fields: [ownerId], references: [id])
  services  Service[]
}

model Service {
  id        Int           @id @default(autoincrement())
  name      String
  url       String
  projectId Int
  createdAt DateTime      @default(now())

  project   Project       @relation(fields: [projectId], references: [id])
  checks    CheckResult[]
}

model CheckResult {
  id           Int      @id @default(autoincrement())
  serviceId    Int
  statusCode   Int?
  responseTime Int?
  checkedAt    DateTime @default(now())
  success      Boolean
  error        String?

  service      Service  @relation(fields: [serviceId], references: [id])
}